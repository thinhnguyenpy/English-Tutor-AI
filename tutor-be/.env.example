# Copy to .env and fill in. Only the AZURE_LLM_* block is required.

DEBUG=false

# --- Database ----------------------------------------------------------------
# Defaults to tutor-be/data/tutor.db. Override to move the file elsewhere.
# DATABASE_URL=sqlite+aiosqlite:///./data/tutor.db

# --- Azure OpenAI ------------------------------------------------------------
AZURE_LLM_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_LLM_API_KEY=
AZURE_LLM_API_VERSION=2024-10-21

# Hot path: replies the student is waiting to hear. Cheap + fast.
AZURE_LLM_MODEL=gpt-4o-mini

# Cold path: memory extraction, grammar feedback, conversation titles. Runs
# detached after the reply is already streaming, so quality beats latency.
# Falls back to AZURE_LLM_MODEL when unset.
AZURE_LLM_ANALYSIS_MODEL=gpt-4o

# Set true only if you need the agent HTTP client to honour system proxy vars.
AZURE_LLM_TRUST_ENV=false
AGENT_TIMEOUT_S=60

# --- Tutoring behaviour ------------------------------------------------------
MAX_ACTIVE_CONVERSATIONS=15
RECENT_TURNS_IN_CONTEXT=10
COLD_PASS_EVERY_N_TURNS=6

# --- Application -------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
